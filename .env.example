# -----------------------------------------------------------------------------
# bKash Checkout (PGW popup) API — direct integration, v1.2.0-beta
# All API endpoints are appended to BKASH_BASE_URL by app/Services/BkashClient.php:
#   POST {BKASH_BASE_URL}/checkout/token/grant            -> id_token (headers: username, password)
#   POST {BKASH_BASE_URL}/checkout/payment/create         -> paymentID (bKash popup createRequest)
#   POST {BKASH_BASE_URL}/checkout/payment/execute/{id}   -> finalize after popup authorization
#   POST {BKASH_BASE_URL}/checkout/payment/query/{id}     -> payment status fallback
# Routes in this project: /bkash/pay (page), /bkash/create, /bkash/execute, /bkash/query (AJAX)
# Production base URL:  https://checkout.pay.bka.sh/v1.2.0-beta
# Sandbox base URL:     https://checkout.sandbox.bka.sh/v1.2.0-beta
# Frontend script:      https://scripts.pay.bka.sh/versions/1.2.0-beta/checkout/bKash-checkout.js
# Credentials come from the bKash merchant portal (app key, app secret, username, password).
# -----------------------------------------------------------------------------
BKASH_SANDBOX=false
BKASH_BASE_URL=https://checkout.pay.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

